# Helper files
.history
.vscode
.idea
*.log

# Java Backend
backend-java/target/
backend-java/*.log
backend-java/.mvn/wrapper/maven-wrapper.jar
backend-java/help.md

# Frontend
frontend-modern/node_modules/
frontend-modern/dist/
frontend-modern/.env.local
frontend-modern/.env.development.local
frontend-modern/.env.test.local
frontend-modern/.env.production.local
frontend-modern/npm-debug.log*
frontend-modern/yarn-debug.log*
frontend-modern/yarn-error.log*

# Environment Secrets
.env
.env.*

# Docker data & Backups
mysql_data/
uploads_data/
database-backup/
data-snapshot/

# NOTE: deliberately not ignoring *.sql / *.sql.gz here anymore. That blanket rule also
# hid backend-java/src/main/resources/db/migration/*.sql from git -- meaning the Flyway
# schema-of-record was never actually committed, only present on whichever machine
# happened to have it locally. Dump files are still excluded via the directory rules
# above (database-backup/, data-snapshot/); a real one-off .sql dump elsewhere should be
# git-ignored at the specific path it lands in, not blocked repo-wide.
